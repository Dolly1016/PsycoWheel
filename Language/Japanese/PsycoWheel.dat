"gamemode.psychoWheel" : "キチガイ風車"
"gamemode.psychoWheel.score" : "回"
"options.psychoWheel.timeLimit" : "制限時間"
"options.psychoWheel.timeLimit.detail" : "キチガイ風車モードの制限時間です。この間に風車を見た回数を競います。"
"gamemode.psychoWheel.taskText" : "キチガイ風車: "認識"されないように見続けよう"
"psychoWheel.clickDirectly" : "キチガイ風車を直接クリックしてください"
"options.psychoWheel.addInterval" : "キチガイ風車の追加間隔"
